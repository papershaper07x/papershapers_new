{
  "name": "papershapers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --import tsx --test tests/site-structure.test.mjs tests/live-rooms.test.mjs tests/attempt-draft.test.ts tests/diagrams.test.tsx tests/generation-response.test.ts tests/billing.test.ts tests/android-release.test.ts tests/study-quota.test.ts tests/observability.test.ts tests/marketplace.test.ts tests/marketplace-safety.test.ts tests/production-readiness.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "backend:test": "python -m unittest discover -s backend/tests -v",
    "check": "npm run lint && npm test && npm run backend:test",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "prebuild": "node scripts/prepare-hosted-build.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/android/build.ps1",
    "test:e2e:marketplace": "node scripts/marketplace-e2e.mjs",
    "audit:deployment": "node scripts/audit-deployment.mjs"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "katex": "^0.18.9",
    "next": "^16.4.0",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^14.2.35",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "katex": "$katex"
  }
}
