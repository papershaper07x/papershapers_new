# Runtime
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_DB_PATH=backend/data/papershapers.db
BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BACKEND_SHARED_SECRET=

# PostgreSQL is required for normal local and hosted operation. Render and
# Netlify use separate least-privilege roles from the same Neon project.
DATABASE_URL=
# Example only: postgresql://papershapers_api:local-password@127.0.0.1:5432/papershapers_dev

# Providers are attempted in this order when their key ring is configured.
# Actual runs fail closed after every configured provider fails; mock is test-only.
LLM_PROVIDER_ORDER=gemini,groq,nvidia
LLM_TIMEOUT_SECONDS=45
ALLOW_MOCK_FALLBACK=false

# Gemini credentials. Never commit real values.
# Comma-separated development key ring. The backend rotates start keys and
# retries the next key only when a request fails. Never commit real values.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Groq uses the OpenAI-compatible chat-completions API. One key or a
# comma-separated development key ring. Obtain keys from console.groq.com.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA NIM uses the OpenAI-compatible API. One key or a comma-separated
# development key ring. Obtain a personal key from build.nvidia.com.
NVIDIA_API_KEYS=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# A validated, identity-free paper is cached after a successful real call.
# It is used only if every configured provider later fails. Changing this
# version invalidates old cache entries after a prompt/curriculum change.
STUDY_GENERATION_CACHE_VERSION=2026-09-source-v1
STUDY_GENERATION_CACHE_HOURS=336

# Comma-separated RSS feeds for the batch command. Empty uses fixture data.
NEWS_RSS_FEEDS=

# Existing local curriculum content from the imported Paper Shapers project.
STUDY_CURRICULUM_CSV_PATH=papershapers/text_files_data2.csv
