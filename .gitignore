# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local-only reference applications and source material. These are kept in one
# quarantined folder so they cannot be committed or shipped by mistake.
/local-reference-archive/
# Empty shells from nested reference repositories can remain after their files
# are moved on Windows; keep them excluded too.
/news_papershapers/
/newspaper/
/newspaper2/
/papershapers/

# Imported/generated curriculum material is local operational data, not source
# code. Re-create or install it locally using the documented source workflow.
/data/ncert_pdfs/
/data/*.sqlite
/data/*.html
/data/*.json
/data/study-source/
/scripts/__pycache__/

# Local packaging output must never become a release artifact by accident.
/site-deploy.tgz

# Local Python backend state and secrets
/backend/.env
/backend/.venv/
/backend/data/*.db*
/backend/data/*.jsonl
/backend/__pycache__/
/backend/**/__pycache__/
