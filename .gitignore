# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Imported legacy/reference applications. These stay available locally for
# architectural reference but are not shipped: several contain generated
# artifacts, large datasets, notebooks, and credentials that must be rotated.
/news_papershapers/
/newspaper/
/newspaper2/
/papershapers/

# Local Python backend state and secrets
/backend/.env
/backend/.venv/
/backend/data/*.db*
/backend/data/*.jsonl
/backend/__pycache__/
/backend/**/__pycache__/
