# Copy these values to .env.local for the standard Next.js frontend.
BACKEND_ORIGIN=http://127.0.0.1:8000
# Set the same high-entropy value in backend/.env. It is mandatory before a
# browser can create, retrieve, assess, or submit private study papers.
BACKEND_SHARED_SECRET=

# Required for normal local and hosted operation. Never expose this value with
# a NEXT_PUBLIC_ prefix.
DATABASE_URL=
REQUEST_LIMITS_ENABLED=false
# Enable shared limits after applying 0005_request_limits.sql with runtime grants.
# Operator/CI migration step only. Never set this credential in the Vercel project.
MIGRATION_DATABASE_URL=
# Example only: postgresql://papershapers_web:local-password@127.0.0.1:5432/papershapers_dev

# Optional Google sign-in. Create a Web OAuth client and use this exact callback
# URI in Google Cloud. Never use NEXT_PUBLIC_ for the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Production-only custom-domain navigation.
NEXT_PUBLIC_HOME_ORIGIN=https://papershapers.in
NEXT_PUBLIC_STUDY_ORIGIN=https://study.papershapers.in/papershapers
NEXT_PUBLIC_MARKET_ORIGIN=https://marketplace.papershapers.in/noticeboard

# Optional web billing. Set up the merchant, migrate/grant, and test first.
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Example only: operator must set final tax-inclusive price in integer paise.
STUDY_MEMBERSHIP_PAISE=19900

# Daily Study AI quota is mandatory (5/account/day); flag above only controls burst limits.
# Apply 0005_request_limits with web SELECT/INSERT/UPDATE grants before runtime.
